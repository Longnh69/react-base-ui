{
  "name": "@ddc/react-base-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "\n========== BUILDING ==========": "/*** RUN BUILD SOURCE ***/",
    "build:types": "tsc --build",
    "build:vite": "vite build",
    "build": "npm-run-all --parallel build:vite build:types",
    "\n========== FORMATTING ==========": "/*** RUN FORMATTING ***/",
    "prettier": "prettier --write src/**/*.{js,jsx,ts,tsx} --ignore-unknown",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx} --ignore-unknown",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prepare:husky": "husky",
    "prepare:pretty-quick": "echo npx pretty-quick --staged > .husky/pre-commit",
    "prepare:commitlint": "echo npx --no -- commitlint --edit ${1} > .husky/commit-msg",
    "prepare": "concurrently \"npm:prepare:*\" -c green",
    "\n========== STORYBOOK ==========": "/*** RUN AND BUILD STORYBOOK ***/",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build:sb": "storybook build"
  },
