    "@fortawesome/react-fontawesome": "^0.2.2",
    "@tsparticles/engine": "^3.5.0",
    "@tsparticles/react": "^3.0.0",
    "antd": "^5.20.2",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.5",
    "ckeditor5": "^43.0.0",
